<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Gradiwin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="CanvasBackgroundColor">#FF202020</Color>
                    <Color x:Key="CheckerLightColor">#FF4A4A4A</Color>
                    <Color x:Key="CheckerDarkColor">#FF3A3A3A</Color>
                    <SolidColorBrush x:Key="OsdBackgroundBrush" Color="#CC2B2B2B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="CanvasBackgroundColor">#FFEBEBEB</Color>
                    <Color x:Key="CheckerLightColor">#FFFFFFFF</Color>
                    <Color x:Key="CheckerDarkColor">#FFD6D6D6</Color>
                    <SolidColorBrush x:Key="OsdBackgroundBrush" Color="#E6F9F9F9" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <Color x:Key="CanvasBackgroundColor">#FF000000</Color>
                    <Color x:Key="CheckerLightColor">#FFFFFFFF</Color>
                    <Color x:Key="CheckerDarkColor">#FF808080</Color>
                    <SolidColorBrush x:Key="OsdBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,16,0,8" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="OsdPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource OsdBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="OsdButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
            </Style>

            <Style x:Key="OsdToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
